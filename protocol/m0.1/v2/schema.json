{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bowfin-lang.org/schema/m0.1-v2.json",
  "title": "Bowfin M0.1 v2 protocol objects",
  "type": "object",
  "oneOf": [
    {"$ref": "#/$defs/mappings_document"},
    {"$ref": "#/$defs/rules_document"},
    {"$ref": "#/$defs/audit_document"},
    {"$ref": "#/$defs/external_document"},
    {"$ref": "#/$defs/visual_document"},
    {"$ref": "#/$defs/limitations_document"},
    {"$ref": "#/$defs/occurrence"},
    {"$ref": "#/$defs/scan_manifest_document"},
    {"$ref": "#/$defs/index"},
    {"$ref": "#/$defs/summary"},
    {"$ref": "#/$defs/evidence_record"},
    {"$ref": "#/$defs/binding_record"}
  ],
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "occurrence_key": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "identifier": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 4096, "not": {"pattern": "(^/|\\\\|(^|/)\\.\\.?(/|$)|\\u0000)"}},
    "protocol_header": {
      "type": "object",
      "required": ["protocol_version"],
      "properties": {"protocol_version": {"const": "m0.1-v2"}}
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mapping_id", "namespace", "original", "policy"],
      "properties": {
        "mapping_id": {"$ref": "#/$defs/identifier"},
        "namespace": {"$ref": "#/$defs/identifier"},
        "original": {"type": "string", "minLength": 1},
        "canonical": {"type": ["string", "null"]},
        "policy": {"enum": ["replace", "retain", "compatibility"]}
      },
      "allOf": [
        {
          "if": {"properties": {"policy": {"const": "retain"}}},
          "then": {"properties": {"canonical": {"type": "null"}}},
          "else": {"required": ["canonical"], "properties": {"canonical": {"type": "string", "minLength": 1}}}
        }
      ]
    },
    "mappings_document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "mappings"],
      "properties": {
        "protocol_version": {"const": "m0.1-v2"},
        "mappings": {"type": "array", "items": {"$ref": "#/$defs/mapping"}}
      }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mapping_id", "unit_kind"],
      "properties": {
        "mapping_id": {"$ref": "#/$defs/identifier"},
        "unit_kind": {"enum": ["path_component", "raw_text", "structured_key", "structured_value", "embedded_identity", "machine_identifier"]},
        "path_exact": {"$ref": "#/$defs/path"},
        "path_prefix": {"$ref": "#/$defs/path"},
        "path_suffix": {"type": "string", "minLength": 1, "maxLength": 4096},
        "json_pointer_prefix": {"type": "string"}
      },
      "oneOf": [
        {"required": ["path_exact"]},
        {"required": ["path_prefix"]},
        {"required": ["path_suffix"]}
      ]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "selector", "expected_count", "role", "phase", "rationale", "representative_context", "boundary_context", "producer", "consumer", "support_policy", "validation_test_id", "historical_relationship"],
      "properties": {
        "rule_id": {"$ref": "#/$defs/identifier"},
        "selector": {"$ref": "#/$defs/selector"},
        "expected_count": {"type": "integer", "minimum": 0},
        "role": {"enum": ["live", "compatibility", "historical"]},
        "phase": {"pattern": "^M[0-7](\\.[0-9]+)?$"},
        "rationale": {"type": "string", "minLength": 1},
        "representative_context": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "boundary_context": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "producer": {"type": ["string", "null"]},
        "consumer": {"type": ["string", "null"]},
        "support_policy": {"type": "string", "minLength": 1},
        "validation_test_id": {"type": "string", "minLength": 1},
        "historical_relationship": {"type": ["string", "null"]}
      }
    },
    "rules_document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "rules"],
      "properties": {
        "protocol_version": {"const": "m0.1-v2"},
        "rules": {"type": "array", "items": {"$ref": "#/$defs/rule"}}
      }
    },
    "audit_family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family_id", "kind", "literal", "namespace", "unit_kinds"],
      "properties": {
        "family_id": {"$ref": "#/$defs/identifier"},
        "kind": {"enum": ["literal", "ascii_casefold_literal", "ascii_digit_suffix", "source_suffix", "path_component"]},
        "literal": {"type": "string", "minLength": 1},
        "namespace": {"$ref": "#/$defs/identifier"},
        "unit_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["path_component", "raw_text", "structured_key", "structured_value", "embedded_identity", "machine_identifier"]}}
      }
    },
    "audit_document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "independently_authored", "families"],
      "properties": {
        "protocol_version": {"const": "m0.1-v2"},
        "independently_authored": {"const": true},
        "families": {"type": "array", "items": {"$ref": "#/$defs/audit_family"}}
      }
    },
    "freshness_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluation_points", "point_in_time_only", "invalidating_events"],
      "properties": {
        "max_age_seconds": {"type": ["integer", "null"], "minimum": 1},
        "invalidating_events": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "point_in_time_only": {"type": "boolean"},
        "evaluation_points": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["owner_acceptance", "pre_integration"]},
          "allOf": [
            {"contains": {"const": "owner_acceptance"}},
            {"contains": {"const": "pre_integration"}}
          ]
        }
      }
    },
    "external_surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface_id", "class", "status", "origin", "acquired_at", "coverage", "snapshot_sha256", "freshness_policy", "limitations"],
      "properties": {
        "surface_id": {"$ref": "#/$defs/identifier"},
        "class": {"$ref": "#/$defs/identifier"},
        "status": {"enum": ["inspected", "not_applicable", "limited", "unavailable", "historical"]},
        "origin": {"type": "string", "minLength": 1},
        "acquired_at": {"type": "string", "format": "date-time"},
        "coverage": {"type": "string", "minLength": 1},
        "snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "freshness_policy": {"$ref": "#/$defs/freshness_policy"},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "external_document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "surfaces"],
      "properties": {
        "protocol_version": {"const": "m0.1-v2"},
        "surfaces": {"type": "array", "items": {"$ref": "#/$defs/external_surface"}}
      }
    },
    "visual_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visual_id", "blob_sha1", "sha256", "scope", "method", "reviewer", "whole_image_inspected", "regions", "limitations"],
      "properties": {
        "visual_id": {"$ref": "#/$defs/identifier"},
        "blob_sha1": {"$ref": "#/$defs/sha1"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "scope": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "reviewer": {"type": "string", "minLength": 1},
        "whole_image_inspected": {"const": true},
        "regions": {"type": "array", "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "visual_document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "visuals"],
      "properties": {
        "protocol_version": {"const": "m0.1-v2"},
        "visuals": {"type": "array", "items": {"$ref": "#/$defs/visual_record"}}
      }
    },
    "limitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limitation_id", "surface", "reason", "consequence", "disposition"],
      "properties": {
        "limitation_id": {"$ref": "#/$defs/identifier"},
        "surface": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "consequence": {"type": "string", "minLength": 1},
        "disposition": {"type": "string", "minLength": 1}
      }
    },
    "limitations_document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "limitations"],
      "properties": {
        "protocol_version": {"const": "m0.1-v2"},
        "limitations": {"type": "array", "items": {"$ref": "#/$defs/limitation"}}
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "byte_start": {"type": "integer", "minimum": 0},
        "byte_end": {"type": "integer", "minimum": 0},
        "component_index": {"type": "integer", "minimum": 0},
        "match_index": {"type": "integer", "minimum": 0},
        "json_pointer": {"type": "string"}
      },
      "minProperties": 1
    },
    "occurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "occurrence_key", "path", "unit_kind", "locator", "source_file_sha256", "original", "canonical", "namespace", "role", "phase", "producer", "consumer", "support_policy", "validation_test_id", "historical_relationship", "mapping_id", "rule_id", "context"],
      "properties": {
        "protocol_version": {"const": "m0.1-v2"},
        "occurrence_key": {"$ref": "#/$defs/occurrence_key"},
        "path": {"$ref": "#/$defs/path"},
        "unit_kind": {"enum": ["path_component", "raw_text", "structured_key", "structured_value", "embedded_identity", "machine_identifier"]},
        "locator": {"$ref": "#/$defs/locator"},
        "source_file_sha256": {"$ref": "#/$defs/sha256"},
        "original": {"type": "string", "minLength": 1},
        "canonical": {"type": ["string", "null"]},
        "namespace": {"$ref": "#/$defs/identifier"},
        "role": {"enum": ["live", "compatibility", "historical"]},
        "phase": {"type": "string"},
        "producer": {"type": ["string", "null"]},
        "consumer": {"type": ["string", "null"]},
        "support_policy": {"type": "string"},
        "validation_test_id": {"type": "string"},
        "historical_relationship": {"type": ["string", "null"]},
        "mapping_id": {"$ref": "#/$defs/identifier"},
        "rule_id": {"$ref": "#/$defs/identifier"},
        "context": {"type": "string"}
      }
    },
    "chunk_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "byte_count", "row_count", "first_key", "last_key"],
      "properties": {
        "path": {"pattern": "^occurrences/[0-9]{4}\\.jsonl$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_count": {"type": "integer", "minimum": 1},
        "row_count": {"type": "integer", "minimum": 1},
        "first_key": {"$ref": "#/$defs/occurrence_key"},
        "last_key": {"$ref": "#/$defs/occurrence_key"}
      }
    },
    "scan_manifest_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "byte_count", "text_status", "structured_status", "structured_error"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_count": {"type": "integer", "minimum": 0},
        "text_status": {"enum": ["utf8", "non_utf8"]},
        "structured_status": {"enum": ["not_json", "valid_json", "invalid_json", "unavailable_non_utf8"]},
        "structured_error": {"type": ["string", "null"]}
      }
    },
    "scan_manifest_document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "files"],
      "properties": {
        "protocol_version": {"const": "m0.1-v2"},
        "files": {"type": "array", "items": {"$ref": "#/$defs/scan_manifest_file"}}
      }
    },
    "index": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "aggregate_sha256", "scan_manifest_sha256", "total_rows", "total_bytes", "chunks"],
      "properties": {
        "protocol_version": {"const": "m0.1-v2"},
        "aggregate_sha256": {"$ref": "#/$defs/sha256"},
        "scan_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "total_rows": {"type": "integer", "minimum": 0},
        "total_bytes": {"type": "integer", "minimum": 0},
        "chunks": {"type": "array", "items": {"$ref": "#/$defs/chunk_descriptor"}}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "total_occurrences", "by_namespace", "by_role", "by_phase", "by_unit_kind"],
      "properties": {
        "protocol_version": {"const": "m0.1-v2"},
        "total_occurrences": {"type": "integer", "minimum": 0},
        "by_namespace": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "by_role": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "by_phase": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "by_unit_kind": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
      }
    },
    "evidence_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_class", "protocol_version", "phase", "source_repository", "source_commit", "source_tree", "accepted_base_commit", "accepted_base_tree", "governing_contract", "tooling", "inputs", "external_snapshots", "generated", "non_authority"],
      "properties": {
        "record_class": {"const": "migration_evidence"},
        "protocol_version": {"const": "m0.1-v2"},
        "phase": {"const": "M0.1"},
        "source_repository": {"type": "string"},
        "source_commit": {"$ref": "#/$defs/sha1"},
        "source_tree": {"$ref": "#/$defs/sha1"},
        "accepted_base_commit": {"$ref": "#/$defs/sha1"},
        "accepted_base_tree": {"$ref": "#/$defs/sha1"},
        "governing_contract": {"type": "object"},
        "tooling": {"type": "object"},
        "inputs": {"type": "object"},
        "external_snapshots": {"type": "array"},
        "generated": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scan_manifest_sha256", "index_sha256", "summary_sha256", "aggregate_sha256"],
          "properties": {
            "scan_manifest_sha256": {"$ref": "#/$defs/sha256"},
            "index_sha256": {"$ref": "#/$defs/sha256"},
            "summary_sha256": {"$ref": "#/$defs/sha256"},
            "aggregate_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "non_authority": {"type": "object"}
      }
    },
    "binding_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_class", "protocol_version", "phase", "sequence", "C", "E", "D", "P", "recovery"],
      "properties": {
        "record_class": {"const": "integration_binding"},
        "protocol_version": {"const": "m0.1-v2"},
        "phase": {"const": "M0.1"},
        "sequence": {"const": ["C", "E", "D", "P"]},
        "C": {"type": "object"},
        "E": {"type": "object"},
        "D": {"type": "object"},
        "P": {"type": "object"},
        "recovery": {"type": "object"}
      }
    }
  }
}
